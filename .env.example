# This project currently has no required environment variables.
#
# The contact form (see src/app/api/contact/route.ts) saves submissions to
# a local file at data/contact-submissions.txt 
#
#  If the contact form is switched back to sending email via
# Resend, these are the variables it used to read:
#
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=
